{
  "name": "torph",
  "version": "0.1.4",
  "description": "Dependency-free animated text component.",
  "homepage": "https://torph.lochie.me",
  "author": "Lochie Axon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lochie/torph.git",
    "directory": "packages/torph"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./vue": {
      "types": {
        "import": "./dist/vue/index.d.mts",
        "require": "./dist/vue/index.d.ts"
      },
      "import": "./dist/vue/index.mjs",
      "require": "./dist/vue/index.js"
    },
    "./plugins/blur": {
      "types": "./dist/plugins/blur/index.d.ts",
      "import": "./dist/plugins/blur/index.mjs",
      "require": "./dist/plugins/blur/index.js"
    },
    "./plugins/words": {
      "types": "./dist/plugins/words/index.d.ts",
      "import": "./dist/plugins/words/index.mjs",
      "require": "./dist/plugins/words/index.js"
    },
    "./plugins/scramble": {
      "types": "./dist/plugins/scramble/index.d.ts",
      "import": "./dist/plugins/scramble/index.mjs",
      "require": "./dist/plugins/scramble/index.js"
    },
    "./plugins/flap": {
      "types": "./dist/plugins/flap/index.d.ts",
      "import": "./dist/plugins/flap/index.mjs",
      "require": "./dist/plugins/flap/index.js"
    },
    "./plugins/typewriter": {
      "types": "./dist/plugins/typewriter/index.d.ts",
      "import": "./dist/plugins/typewriter/index.mjs",
      "require": "./dist/plugins/typewriter/index.js"
    },
    "./plugins/tokens": {
      "types": "./dist/plugins/tokens/index.d.ts",
      "import": "./dist/plugins/tokens/index.mjs",
      "require": "./dist/plugins/tokens/index.js"
    },
    "./plugins/odometer": {
      "types": "./dist/plugins/odometer/index.d.ts",
      "import": "./dist/plugins/odometer/index.mjs",
      "require": "./dist/plugins/odometer/index.js"
    },
    "./plugins/wave": {
      "types": "./dist/plugins/wave/index.d.ts",
      "import": "./dist/plugins/wave/index.mjs",
      "require": "./dist/plugins/wave/index.js"
    },
    "./plugins/wipe": {
      "types": "./dist/plugins/wipe/index.d.ts",
      "import": "./dist/plugins/wipe/index.mjs",
      "require": "./dist/plugins/wipe/index.js"
    },
    "./plugins/caseless": {
      "types": "./dist/plugins/caseless/index.d.ts",
      "import": "./dist/plugins/caseless/index.mjs",
      "require": "./dist/plugins/caseless/index.js"
    },
    "./plugins/anagram": {
      "types": "./dist/plugins/anagram/index.d.ts",
      "import": "./dist/plugins/anagram/index.mjs",
      "require": "./dist/plugins/anagram/index.js"
    },
    "./plugins/stack": {
      "types": "./dist/plugins/stack/index.d.ts",
      "import": "./dist/plugins/stack/index.mjs",
      "require": "./dist/plugins/stack/index.js"
    },
    "./plugins/squash": {
      "types": "./dist/plugins/squash/index.d.ts",
      "import": "./dist/plugins/squash/index.mjs",
      "require": "./dist/plugins/squash/index.js"
    },
    "./plugins/redline": {
      "types": "./dist/plugins/redline/index.d.ts",
      "import": "./dist/plugins/redline/index.mjs",
      "require": "./dist/plugins/redline/index.js"
    },
    "./plugins/countup": {
      "types": "./dist/plugins/countup/index.d.ts",
      "import": "./dist/plugins/countup/index.mjs",
      "require": "./dist/plugins/countup/index.js"
    },
    "./plugins/skeleton": {
      "types": "./dist/plugins/skeleton/index.d.ts",
      "import": "./dist/plugins/skeleton/index.mjs",
      "require": "./dist/plugins/skeleton/index.js"
    },
    "./plugins/magnet": {
      "types": "./dist/plugins/magnet/index.d.ts",
      "import": "./dist/plugins/magnet/index.mjs",
      "require": "./dist/plugins/magnet/index.js"
    },
    "./plugins/weight": {
      "types": "./dist/plugins/weight/index.d.ts",
      "import": "./dist/plugins/weight/index.mjs",
      "require": "./dist/plugins/weight/index.js"
    },
    "./debug": {
      "types": "./dist/debug/index.d.ts",
      "import": "./dist/debug/index.mjs",
      "require": "./dist/debug/index.js"
    },
    "./svelte": {
      "types": {
        "import": "./dist/svelte/index.d.mts",
        "require": "./dist/svelte/index.d.ts"
      },
      "svelte": "./dist/svelte/index.mjs",
      "import": "./dist/svelte/index.mjs",
      "require": "./dist/svelte/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/build-svelte.mjs",
    "dev": "tsup --watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pre-commit": "lint-staged"
  },
  "keywords": [
    "react",
    "vue",
    "svelte",
    "text",
    "animation",
    "morph"
  ],
  "bugs": {
    "url": "https://github.com/lochie/torph/issues"
  },
  "sideEffects": false,
  "files": [
    "dist/*"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "svelte": ">=5",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@torph/test-cases": "workspace:*",
    "@types/react": "^18.2.15",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.12.0",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "svelte": "^5.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11",
    "vue": "^3.3.0"
  }
}
