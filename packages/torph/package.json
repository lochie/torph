{
  "name": "torph",
  "version": "0.1.0",
  "description": "Dependency-free animated text component.",
  "homepage": "https://torph.lochie.me",
  "author": "Lochie Axon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lochie/torph.git",
    "directory": "packages/torph"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./vue": {
      "types": {
        "import": "./dist/vue/index.d.mts",
        "require": "./dist/vue/index.d.ts"
      },
      "import": "./dist/vue/index.mjs",
      "require": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": {
        "import": "./dist/svelte/index.d.mts",
        "require": "./dist/svelte/index.d.ts"
      },
      "svelte": "./dist/svelte/index.mjs",
      "import": "./dist/svelte/index.mjs",
      "require": "./dist/svelte/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/build-svelte.mjs",
    "dev": "tsup --watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pre-commit": "lint-staged"
  },
  "keywords": [
    "react",
    "vue",
    "svelte",
    "text",
    "animation",
    "morph"
  ],
  "bugs": {
    "url": "https://github.com/lochie/torph/issues"
  },
  "sideEffects": false,
  "files": [
    "dist/*"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "svelte": ">=5",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@torph/test-cases": "workspace:*",
    "@types/react": "^18.2.15",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.12.0",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "svelte": "^5.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.18",
    "vue": "^3.3.0"
  }
}
