{
  "name": "torph",
  "version": "0.0.5",
  "description": "Dependency-free animated text component.",
  "author": "Lochie Axon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lochie/torph.git",
    "directory": "packages/torph"
  },
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.mts",
      "import": "./dist/vue/index.mjs",
      "require": "./dist/vue/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.mjs",
      "import": "./dist/svelte/index.mjs",
      "require": "./dist/svelte/index.cjs"
    },
    "./svelte/TextMorph.svelte": {
      "types": "./dist/svelte/TextMorph.svelte.d.ts",
      "svelte": "./dist/svelte/TextMorph.svelte",
      "default": "./dist/svelte/TextMorph.svelte"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint -c .eslintrc.cjs ./src/**/*.{ts,tsx}",
    "lint:fix": "eslint --fix -c .eslintrc.cjs ./src/**/*.{ts,tsx}",
    "pre-commit": "lint-staged"
  },
  "keywords": [
    "react",
    "vue",
    "svelte",
    "text",
    "animation",
    "morph"
  ],
  "bugs": {
    "url": "https://github.com/lochie/torph/issues"
  },
  "files": [
    "dist/*"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@types/react": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "eslint": "^9.36.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.0.3",
    "publint": "^0.3.17",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "svelte": "^4.0.0",
    "svelte2tsx": "^0.7.51",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vue": "^3.3.0"
  }
}
